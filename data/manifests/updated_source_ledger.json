},
{
"id": "NN_TERRAIN_RISK_PROXY",
"type": "DERIVED_OUTPUT",
"title": "NeuroNexus terrain-risk proxy",
"status": "IMPLEMENTED",
"description": "Transparent terrain-burden proxy used for route comparison. Not a NASA-certified safety assessment."
},
{
"id": "NN_EVA_MODEL",
"type": "TEAM_METHOD",
"title": "Estimated EVA time model",
"status": "IMPLEMENTED",
"description": "Configurable planning estimate based on route distance and ascent allowance. Not operational flight data."
},
{
"id": "NN_EXPLORATION_ZONES",
"type": "DERIVED_OUTPUT",
"title": "Potential Exploration Zone",
"status": "IMPLEMENTED",
"description": "Bounded terrain-derived candidate zones using NeuroNexus criteria and exploration context. Not an official NASA landing or safety zone."
},
{
"id": "NN_MISSION_SIM",
"type": "TEAM_EXPERIMENT",
"title": "Crewed Mars mission-console simulation profile",
"status": "IMPLEMENTED",
"description": "Configurable simulation values for mission-planning interface experiments; simulation values are not measurements."
},
{
"id": "NN_SOURCE_PROVENANCE",
"type": "TEAM_METHOD",
"title": "Evidence/provenance classification system",
"status": "IMPLEMENTED",
"description": "Separates NASA observations, NASA references, model outputs, derived computations, simulations and unavailable evidence."
},
{
"id": "GEMINI",
"type": "AI_INTERPRETATION",
"title": "Google Gemini interpretation layer",
"status": "IMPLEMENTED",
"url": "https://ai.google.dev/gemini-api/docs",
"description": "Interprets structured NeuroNexus results, explains trade-offs and supports mission-console interaction. Gemini does not generate deterministic route geometry or alter computed numerical results."
}
],
"evidence_statuses": {
"USED": "External source actively used by an application subsystem.",
"USED_AND_INGESTED": "External source data are locally ingested/indexed and used by the scientific pipeline.",
"USED_AS_REFERENCE": "External source supports scientific or mission context but is not necessarily a locally ingested measurement dataset.",
"USED_AS_REFERENCE_ONLY": "External source is linked/referenced for context; the underlying full dataset is not ingested.",
"CATALOGUED_NOT_INGESTED": "The source is registered in the science catalogue/provenance roadmap but its data are not currently ingested for site-specific calculations.",
"UNAVAILABLE": "The source is known but unavailable in the current runtime; NeuroNexus does not fabricate a substitute."
},
"project_boundary": {
"no_fake_data": true,
"no_nasa_certified_safety_claims": true,
"no_present_day_habitability_claim_from_ancient_evidence": true,
"no_resource_confirmation_from_context_layers": true,
"ai_is_not_presented_as_nasa_observation": true,
"unavailable_data_are_reported_explicitly": true
}
