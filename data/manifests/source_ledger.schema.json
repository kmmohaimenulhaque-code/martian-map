{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmmohaimenulhaque-code/martian-map/data/manifests/source_ledger.schema.json",
  "title": "NeuroNexus canonical source ledger (neuronexus.source-ledger.v3)",
  "type": "object",
  "required": ["schema", "project", "evidence_classes", "ingestion_statuses", "entries"],
  "properties": {
    "schema": {"const": "neuronexus.source-ledger.v3"},
    "project": {"const": "NeuroNexus"},
    "generated_by": {"type": "string"},
    "evidence_classes": {"type": "object"},
    "ingestion_statuses": {"type": "object"},
    "legacy_export": {"type": "object"},
    "legacy_provenance": {"type": "object"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "aliases", "organization", "product_title", "evidence_class", "ingestion_status",
                     "used_by", "caveats", "verified_on", "verification_note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]*$"},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "organization": {"type": "string", "minLength": 1},
          "mission": {"type": ["string", "null"]},
          "instrument": {"type": ["string", "null"]},
          "product_title": {"type": "string", "minLength": 1},
          "product_id_pattern": {"type": ["string", "null"]},
          "doi": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"], "pattern": "^https://"},
          "landing_page": {"type": ["string", "null"], "pattern": "^https://"},
          "license": {"type": ["string", "null"]},
          "citation": {"type": ["string", "null"]},
          "evidence_class": {"enum": ["OBSERVED", "NASA REFERENCE", "MODELED", "DERIVED", "COMPUTED", "SIMULATED",
                                      "AI INTERPRETATION"]},
          "ingestion_status": {"type": "string",
                               "pattern": "^(INGESTED|QUERIED LIVE|REFERENCE ONLY|CATALOGED NOT INGESTED|UNAVAILABLE)( \\(.+\\))?$"},
          "access_method": {"type": ["string", "null"]},
          "used_by": {"type": "array", "items": {"type": "string"}},
          "retrieved_at": {"type": ["string", "null"]},
          "version": {"type": ["string", "null"]},
          "archive_lag_days": {"type": ["number", "null"]},
          "caveats": {"type": "array", "items": {"type": "string"}},
          "verified_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "verification_note": {"type": "string"},
          "legacy": {"type": "object", "required": ["id", "role", "status", "used_for"]},
          "legacy_team_output": {"type": "object", "required": ["type", "status", "description"]},
          "provenance": {"type": "object", "required": ["class", "use"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
