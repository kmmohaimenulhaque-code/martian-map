GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
# Optional: Gemini model (defaults to a current Flash model; falls back automatically)
# GEMINI_MODEL=gemini-3.6-flash
# Optional: AI provider (science/ai/provider.py). "auto" (default) enables fast fallback routing;
# "gemini" uses Gemini only.
# AI_PROVIDER=auto
# Optional fallback providers, tried in this order when Gemini fails, once per model, no retries.
# Policy: no Chinese or Russian models or vendors.
# GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# MISTRAL_API_KEY=PASTE_YOUR_MISTRAL_KEY_HERE
# NVIDIA_API_KEY=PASTE_YOUR_NVIDIA_NIM_KEY_HERE
# GITHUB_MODELS_TOKEN=PASTE_A_GITHUB_PAT_WITH_MODELS_READ_HERE
# COHERE_API_KEY=PASTE_YOUR_COHERE_KEY_HERE
# OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
# Optional model overrides (comma-separated, tried in order):
# GROQ_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b
# MISTRAL_MODEL=mistral-large-latest,mistral-small-latest
# NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b,google/diffusiongemma-26b-a4b-it
# GITHUB_MODELS_MODEL=openai/gpt-4o,microsoft/Phi-4
# COHERE_MODEL=command-r-plus-08-2024
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: explicit path to DustScenario_MY34.nc
# NEURONEXUS_DUST_FILE=/app/DustScenario_MY34.nc
