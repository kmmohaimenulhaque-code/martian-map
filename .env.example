GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
# Optional: Gemini model (defaults to a current Flash model; falls back automatically)
# GEMINI_MODEL=gemini-3.6-flash
# Optional: AI provider (science/ai/provider.py). "auto" (default) routes between the fine-tuned
# Qwen voice model and Gemini tool calling (science/ai/router.py); "gemini" uses Gemini only.
# AI_PROVIDER=auto
# Optional: fine-tuned Qwen (llama.cpp server, OpenAI-compatible). Without it, "auto" is plain Gemini.
# docker compose sets this to the qwen service automatically.
# QWEN_BASE_URL=http://127.0.0.1:8081
# QWEN_MODEL=neuronexus-qwen3-4b-mars-intel
# QWEN_TIMEOUT_S=120
# Optional: explicit path to DustScenario_MY34.nc
# NEURONEXUS_DUST_FILE=/app/DustScenario_MY34.nc
